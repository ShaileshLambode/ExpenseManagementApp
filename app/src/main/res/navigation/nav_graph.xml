<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.expensemanagementapp.ui.dashboard.DashboardFragment"
        android:label="Home"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_analytics"
        android:name="com.example.expensemanagementapp.ui.analytics.AnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/navigation_add"
        android:name="com.example.expensemanagementapp.ui.expenses.ExpensesFragment"
        android:label="Add Transaction"
        tools:layout="@layout/fragment_expenses" />

    <fragment
        android:id="@+id/navigation_goals"
        android:name="com.example.expensemanagementapp.ui.goals.GoalsFragment"
        android:label="Goals"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/navigation_history"
        android:name="com.example.expensemanagementapp.ui.history.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.expensemanagementapp.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.example.expensemanagementapp.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/navigation_help"
        android:name="com.example.expensemanagementapp.ui.help.HelpFragment"
        android:label="Help"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/navigation_backup"
        android:name="com.example.expensemanagementapp.ui.backup.BackupFragment"
        android:label="Backup &amp; Restore"
        tools:layout="@layout/fragment_backup" />

    <fragment
        android:id="@+id/navigation_about"
        android:name="com.example.expensemanagementapp.ui.settings.AboutFragment"
        android:label="About Us"
        tools:layout="@layout/fragment_about" />

    <fragment
        android:id="@+id/nav_plans_dest"
        android:name="com.example.expensemanagementapp.ui.plans.PlansFragment"
        android:label="Plans"
        tools:layout="@layout/fragment_plans" />

    <fragment
        android:id="@+id/navigation_recycle_bin"
        android:name="com.example.expensemanagementapp.ui.recyclebin.RecycleBinFragment"
        android:label="Recycle Bin"
        tools:layout="@layout/fragment_recycle_bin" />

    <fragment
        android:id="@+id/navigation_feedback"
        android:name="com.example.expensemanagementapp.ui.help.FeedbackFragment"
        android:label="Review &amp; Feedback"
        tools:layout="@layout/fragment_feedback" />

    <fragment
        android:id="@+id/navigation_whats_new"
        android:name="com.example.expensemanagementapp.ui.settings.WhatsNewFragment"
        android:label="What's New"
        tools:layout="@layout/fragment_whats_new" />
</navigation>
