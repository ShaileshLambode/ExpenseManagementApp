# Copy this file to ".env" and fill in your password.  NEVER commit ".env".
# If the password contains special characters (@ : / # %), URL-encode them (@ -> %40).
ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/mulya_dev
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/mulya_test
